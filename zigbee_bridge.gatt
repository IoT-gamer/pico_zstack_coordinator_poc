// Service: Zigbee Bridge Custom Service
PRIMARY_SERVICE, 0000FF00-0000-1000-8000-00805F9B34FB

// Characteristic: Zigbee Device Event (Notify)
// Data Format: [2-byte NWK Addr] [1-byte Cluster ID] [N-byte Payload]
CHARACTERISTIC, 0000FF01-0000-1000-8000-00805F9B34FB, NOTIFY, "Device Event Stream"

// Characteristic: Bridge Control (Write)
// Cmd 0x01: Open Network (Permit Join)
// Cmd 0x02: Reset Coordinator
CHARACTERISTIC, 0000FF02-0000-1000-8000-00805F9B34FB, WRITE_WITHOUT_RESPONSE | DYNAMIC, "Bridge Control"